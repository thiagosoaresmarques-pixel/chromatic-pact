/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/cards/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/cards/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/map/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/map/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/tabletops/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/music/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
